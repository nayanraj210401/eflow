# Optional: eflob Connect source builds
# Leave these unset to disable optional eflob Connect features in local source builds.
# Release builds inject their public values at build time. Do not add server-side
# secrets to this file.

# Get these from the Clerk Dashboard under API keys, JWT templates, and OAuth applications.
# EFLOB_CLERK_PUBLISHABLE_KEY=pk_test_...
# EFLOB_CLERK_JWT_TEMPLATE=eflob-relay
# EFLOB_CLERK_CLI_OAUTH_CLIENT_ID=oauthapp_...

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in EFLOB_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# EFLOB_APPLE_TEAM_ID=ABC1234567
# EFLOB_MACOS_PROVISIONING_PROFILE=/absolute/path/to/eflob.provisionprofile
# EFLOB_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Get this from your relay deployment. `infra/relay` deploys update it automatically.
# EFLOB_RELAY_URL=https://relay.example.com

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.eflob.dev; override to test against a staging deployment.
# EFLOB_HOSTED_APP_URL=https://nightly.app.eflob.dev

# Public, ingest-only mobile OpenTelemetry configuration.
# EFLOB_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# EFLOB_MOBILE_OTLP_TRACES_DATASET=eflob-mobile-traces-dev
# EFLOB_MOBILE_OTLP_TRACES_TOKEN=xaat-...

# Create your own Apple Developer account and get your Team ID
# EFLOB_APPLE_TEAM_ID=TODO_APPLE_TEAM_ID
# Create a new project at expo.dev and copy its Project ID
# EFLOB_EAS_PROJECT_ID=TODO_EAS_PROJECT_ID
# Your Expo organization/username
# EFLOB_EXPO_OWNER=TODO_EXPO_OWNER
# Your own Clerk instance domain (used for passkey relying party)
# EFLOB_CLERK_DOMAIN=TODO_CLERK_DOMAIN
